{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {arizona, {git, "https://github.com/arizona-framework/arizona.git", {branch, "main"}}},
    {cowboy, "2.14.2"}
]}.

{dialyzer, [
    {plt_apps, all_deps},
    {plt_extra_apps, [
        compiler,
        syntax_tools,
        eunit,
        common_test,
        cowboy,
        tools
    ]},
    {warnings, [
        unknown,
        unmatched_returns
    ]},
    incremental
]}.

{alias, [
    {test, [
        {eunit, "--cover"},
        {ct, "--cover"}
    ]},
    {check_cover, [
        {cover, "--min_coverage 80 --verbose"}
    ]},
    {doc, [
        ex_doc
    ]}
]}.

{profiles, [
    {default, [
        {xref_checks, [
            exports_not_used,
            undefined_function_calls,
            undefined_functions,
            locals_not_used,
            deprecated_function_calls,
            deprecated_functions
        ]}
    ]},
    {test, [
        {cover_enabled, true},
        {cover_opts, [verbose]},
        {erl_opts, [
            debug_info,
            nowarn_missing_spec,
            warnings_as_errors
        ]},
        {dialyzer, [
            {plt_apps, all_deps},
            {plt_extra_apps, [
                compiler,
                syntax_tools,
                eunit,
                common_test,
                ranch,
                cowboy,
                tools
            ]},
            {warnings, [
                unknown,
                unmatched_returns
            ]},
            incremental
        ]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        {xref_checks, [
            undefined_function_calls,
            undefined_functions,
            locals_not_used,
            deprecated_function_calls,
            deprecated_functions
        ]},
        {xref_ignores, [{rebar_agent, do, 1}]}
    ]}
]}.

{project_plugins, [
    {erlfmt, "1.8.0"},
    {rebar3_lint, "5.0.3"},
    {rebar3_hank, "1.6.1"},
    {rebar3_hex, "7.1.0"},
    {rebar3_ex_doc, "0.2.31"}
]}.

{hank, [
    {ignore, [
        {"test/arizona_cowboy_app_SUITE.erl", [unnecessary_function_arguments]},
        {"test/support/arizona_drainable.erl", [unnecessary_function_arguments]}
    ]}
]}.

{erlfmt, [
    write,
    {files, [
        "elvis.config",
        "rebar.config",
        "src/*.app.src",
        "src/**/*.erl",
        "test/**/*.erl"
    ]}
]}.

{ex_doc, [
    {extras, [
        "README.md",
        "CONTRIBUTING.md",
        "LICENSE.md"
    ]},
    {main, "README.md"},
    {api_reference, false},
    {source_url, "https://github.com/arizona-framework/arizona_cowboy"},
    {prefix_ref_vsn_with_v, false}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.
