%% `arizona` is no dependency (see the test profile), so the adapter compiles
%% without its `arizona_server`/`arizona_req` behaviours on the path; the
%% callbacks are checked by every build that has them, this one's tests included.
{erl_opts, [debug_info, warnings_as_errors, nowarn_undefined_behaviour]}.

{deps, [
    {cowboy, "2.18.0"}
]}.

{dialyzer, [
    {plt_apps, all_deps},
    {plt_extra_apps, [
        compiler,
        syntax_tools,
        eunit,
        common_test,
        cowboy,
        cowlib,
        ranch,
        tools
    ]},
    {warnings, [
        unknown,
        unmatched_returns
    ]},
    incremental
]}.

{alias, [
    {test, [
        {eunit, "--cover"},
        {ct, "--cover"}
    ]},
    {check_cover, [
        {cover, "--min_coverage 80 --verbose"}
    ]},
    {doc, [
        ex_doc
    ]}
]}.

{profiles, [
    {default, [
        {xref_checks, [
            exports_not_used,
            undefined_function_calls,
            undefined_functions,
            locals_not_used,
            deprecated_function_calls,
            deprecated_functions
        ]}
    ]},
    {test, [
        %% Arizona only here: arizona's own test profile depends on this package,
        %% so a regular dependency back would be a cycle rebar3 refuses.
        {deps, [
            {arizona, {git, "https://github.com/arizona-framework/arizona.git", {branch, "main"}}}
        ]},
        {cover_enabled, true},
        {cover_opts, [verbose]},
        {erl_opts, [
            debug_info,
            nowarn_missing_spec,
            warnings_as_errors
        ]},
        {dialyzer, [
            {plt_apps, all_deps},
            {plt_extra_apps, [
                compiler,
                syntax_tools,
                eunit,
                common_test,
                arizona,
                cowboy,
                cowlib,
                ranch,
                tools
            ]},
            {warnings, [
                unknown,
                unmatched_returns
            ]},
            incremental
        ]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        {xref_checks, [
            undefined_function_calls,
            undefined_functions,
            locals_not_used,
            deprecated_function_calls,
            deprecated_functions
        ]},
        {xref_ignores, [{rebar_agent, do, 1}]}
    ]}
]}.

{project_plugins, [
    {erlfmt, "1.8.0"},
    {rebar3_lint, "6.0.0"},
    {rebar3_hank, "2.0.1"},
    {rebar3_hex, "7.3.0"},
    {rebar3_ex_doc, "0.3.0"}
]}.

{erlfmt, [
    write,
    {files, [
        "elvis.config",
        "rebar.config",
        "src/*.app.src",
        "src/**/*.erl",
        "test/**/*.erl"
    ]}
]}.

{ex_doc, [
    {extras, [
        "README.md",
        "CONTRIBUTING.md",
        "LICENSE.md"
    ]},
    {main, "README.md"},
    {api_reference, false},
    {source_url, "https://github.com/arizona-framework/arizona_cowboy"},
    {prefix_ref_vsn_with_v, false}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.
